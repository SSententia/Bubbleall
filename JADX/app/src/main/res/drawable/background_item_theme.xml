<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/windowBubble"
        android:height="38dp"
        android:width="38dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="#cccccc"/>
            <solid android:color="#1c1c1c"/>
            <corners android:radius="7dp"/>
        </shape>
    </item>
    <item
        android:id="@+id/colorBubble"
        android:height="18dp"
        android:width="18dp"
        android:left="23dp"
        android:top="23dp">
        <shape>
            <corners android:radius="100dp"/>
            <solid android:color="#3f51b5"/>
        </shape>
    </item>
</layer-list>
